# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# Development
DATABASE_URL_DEV=postgresql://user:password@localhost:5432/medpath_ai
CORS_ORIGIN_DEV=http://localhost:5173,http://localhost:5174,http://localhost:5175
NODE_ENV_DEV=development

# Production (Render)
DATABASE_URL=postgresql://user:password@hostname.onrender.com/database_name
JWT_SECRET=your-random-jwt-secret-here
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-url.vercel.app,https://your-domain.com

# General
LOG_QUERIES=true
